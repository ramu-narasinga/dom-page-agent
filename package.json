{
  "name": "dom-page-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=iife --global-name=MiniPageAgentBundle --outfile=dist/mini-page-agent.js",
    "build:watch": "npm run build -- --watch",
    "demo": "npx serve demo-app -l 3000",
    "bundle-host": "npx serve dist -l 8081",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
